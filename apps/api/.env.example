DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rentaltoys
# Production needs 32+ random characters (Render generates one automatically).
JWT_SECRET=change-me
PORT=4000
# Comma-separated browser origins; leave empty locally to allow all.
CORS_ORIGINS=
# Used by `npm run -w @rentaltoys/api db:seed:base` to create the first admin.
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
