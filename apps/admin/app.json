{
  "expo": {
    "name": "RentalToys Admin",
    "slug": "rentaltoys-admin",
    "scheme": "rentaltoys-admin",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": { "bundler": "metro", "output": "single" },
    "plugins": ["expo-router", "expo-secure-store", ["expo-camera", { "cameraPermission": "Allow camera access to scan toy, piece and bin QR labels." }]],
    "experiments": { "typedRoutes": false }
  }
}
